<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Account ALL" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Account-Landing" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountLandingTest"/>
        </classes>
    </test>
    <test name="Account-Interact" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountInteractTest"/>
        </classes>
    </test>
    <test name="Account-Edge" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountEdgeTest"/>
        </classes>
    </test>
</suite>
