<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Language reflection matrix" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Language-Matrix" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.LanguageReflectionMatrixDump">
                <methods>
                    <include name="hindiReflectionMatrix"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
