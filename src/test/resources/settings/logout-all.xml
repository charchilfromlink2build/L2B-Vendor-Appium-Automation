<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Logout all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Logout-Landing" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.LogoutLandingTest"/>
        </classes>
    </test>
    <test name="Logout-Interact" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.LogoutInteractTest"/>
        </classes>
    </test>
    <test name="Logout-Edge" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.LogoutEdgeTest"/>
        </classes>
    </test>
</suite>
