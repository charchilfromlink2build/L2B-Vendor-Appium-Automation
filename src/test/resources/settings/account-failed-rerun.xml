<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Account failed rerun" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Account-Failed-Rerun" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountLandingTest">
                <methods>
                    <include name="fullNameAndMobile"/>
                    <include name="companyNameAndEmail"/>
                </methods>
            </class>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountInteractTest">
                <methods>
                    <include name="phoneUnchangedAfterCancel"/>
                    <include name="chromeIntactAfterPhoto"/>
                </methods>
            </class>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AccountEdgeTest">
                <methods>
                    <include name="photoOpenCloseTwice"/>
                    <include name="reopenAfterDrawerDismiss"/>
                    <include name="saveChangesPresentButNeverTapped"/>
                    <include name="emailIntactAfterCancel"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
