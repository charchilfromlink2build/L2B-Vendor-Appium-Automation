<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor App Settings all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="AppSettings-Landing" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AppSettingsLandingTest"/>
        </classes>
    </test>
    <test name="AppSettings-Interact" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AppSettingsInteractTest"/>
        </classes>
    </test>
    <test name="AppSettings-Edge" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.AppSettingsEdgeTest"/>
        </classes>
    </test>
</suite>
