<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Language Hindi reflection dump" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Language-Hindi-Reflect" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.settings.presentation.tests.LanguageHindiReflectionDump">
                <methods>
                    <include name="reflectHindiAcrossModules"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
