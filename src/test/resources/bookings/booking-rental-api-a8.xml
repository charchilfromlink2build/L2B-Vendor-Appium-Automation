<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-A8 — LIVE via LifecycleApi assign persists. -->
<suite name="L2B RB-A8" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-A8 assignRequiresOverlapWhenBusy" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.data.api.RentalBookingLifecycleApiTest">
                <methods>
                    <include name="assignRequiresOverlapWhenBusy"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
