<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-A12 — LIVE. Pure API: foreign vendor token cannot reach another vendor's booking. -->
<suite name="L2B RB-A12" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-A12 otherVendorBookingIsForbidden" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.data.api.RentalBookingApiGapTest">
                <methods>
                    <include name="otherVendorBookingIsForbidden"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
