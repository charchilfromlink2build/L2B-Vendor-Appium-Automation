<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-S15 — expect SKIP/BLOCKED unless /tmp/l2b-s15-seed.json near-expiry rental exists. -->
<suite name="L2B RB-S15" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-S15 expiredRequestIsNotBooked" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.presentation.tests.rentalbooking.RentalBookingLifecycleTest">
                <methods>
                    <include name="expiredRequestIsNotBooked"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
