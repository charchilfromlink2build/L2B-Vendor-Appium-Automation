<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-L14 — LIVE. Read Home Upcoming stat vs Upcoming list card count. -->
<suite name="L2B RB-L14" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-L14 upcomingCountMatchesHomeStat" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.presentation.tests.rentalbooking.RentalBookingLandingTest">
                <methods>
                    <include name="upcomingCountMatchesHomeStat"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
