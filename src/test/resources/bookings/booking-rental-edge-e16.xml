<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-E16 — LIVE. Long machine name + long address layout on Quick Booking card. -->
<suite name="L2B RB-E16" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-E16 longNamesStayInCard" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.presentation.tests.rentalbooking.RentalBookingEdgeTest">
                <methods>
                    <include name="longNamesStayInCard"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
