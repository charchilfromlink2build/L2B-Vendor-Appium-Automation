<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-L10 — LIVE. Navigation only: Active tab shows list or empty state. -->
<suite name="L2B RB-L10" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-L10 activeTabListOrEmptyState" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.presentation.tests.rentalbooking.RentalBookingLandingTest">
                <methods>
                    <include name="activeTabListOrEmptyState"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
