<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- RB-A11 — LIVE. Missing + expired/revoked token rejected (ApiGapTest). -->
<suite name="L2B RB-A11" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="RB-A11 endpointsRejectExpiredToken" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.bookings.data.api.RentalBookingApiGapTest">
                <methods>
                    <include name="endpointsRejectExpiredToken"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
